# Copy this file to .env.local and fill in the values
# Your OpenAI API key (server-side only)
OPENAI_API_KEY=sk-...
OPENAI_PROJECT=proj_...

# WordPress Application Password used to upload AI Tools directory icons
# (uploaded from /admin/ai-tools) to the WordPress Media Library via wp-json/wp/v2/media.
# Generate one under wp-admin -> Users -> Profile -> Application Passwords.
# WORDPRESS_SITE_URL is optional; it defaults to the origin of NEXT_PUBLIC_API_BASE_URL.
# WORDPRESS_SITE_URL=https://ai4kingdom.com
WORDPRESS_MEDIA_USERNAME=your-wp-username
WORDPRESS_MEDIA_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# 伺服器端查詢會員方案用的共享密鑰。
# 需與 WordPress wp-config.php 的 A4K_SERVICE_TOKEN 常數一致。
# 未設定時，API 只能取得目前登入者自己的方案，無法用 userId 查詢他人。
WP_SERVICE_TOKEN=
